{
  "name": "carcalculator-scraper",
  "private": true,
  "version": "1.0.0",
  "description": "Watches nettiauto.com for new car listings matching a spec and announces them to Discord",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/index.js",
    "dry-run": "node src/index.js --dry-run",
    "seed": "node src/index.js --seed",
    "list": "node src/index.js --list",
    "test": "node --test test/*.test.js"
  }
}

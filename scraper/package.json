{
  "name": "listing-watch",
  "private": true,
  "version": "1.0.0",
  "description": "Watches listing sites for new listings matching a spec and announces them to Discord. One adapter per site; nettiauto.com is the first.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/index.js",
    "dry-run": "node src/index.js --dry-run",
    "seed": "node src/index.js --seed",
    "list": "node src/index.js --list",
    "doctor": "node src/doctor.js",
    "test": "node --test test/*.test.js"
  }
}

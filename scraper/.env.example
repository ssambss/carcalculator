# Copy to .env and fill in. Never commit the real file.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Reaction pickup (optional): react to a posted car in Discord and it is added
# to the TCO calculator. Needs both of these; with neither set, it is skipped.
# Bot token: discord.com/developers -> your app -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=
# Classic GitHub token with ONLY the `gist` scope (same kind the app's
# GitHub sync uses).
GIST_TOKEN=
